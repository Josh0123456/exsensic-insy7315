@model Exsensic.Web.Models.Admin.UserManagementViewModel
@{
    ViewData["Title"] = "Users";
}
<partial name="_PageHeader" model='@(new PageHeaderViewModel
         {
             Title = "Users",
             Eyebrow = "Admin",
             Subtitle = "Create staff accounts and control who can sign in."
         })' />

<form asp-action="Users" method="get" class="filter-form" aria-label="User filters">
    <div class="form-field">
        <label for="role">Role</label>
        <select id="role" name="role">
            <option value="">All roles</option>
            <option value="Client" selected="@(Model.Role == "Client")">Client</option>
            <option value="Staff" selected="@(Model.Role == "Staff")">Staff</option>
            <option value="Admin" selected="@(Model.Role == "Admin")">Admin</option>
        </select>
    </div>
    <button class="button-primary" type="submit">Apply</button>
    <a class="button-secondary" asp-action="Users">Clear</a>
</form>

@if (Model.Users.Count == 0)
{
    <partial name="_EmptyState" model='@(new EmptyStateViewModel
             {
                 Title = "No users found",
                 Message = "Try another role or check again later."
             })' />
}
else
{
    <table class="booking-table">
        <caption>Users</caption>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>@(user.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <form asp-action="ToggleActive" method="post" data-single-submit>
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                            <button type="submit" class="button-secondary">
                                @(user.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
