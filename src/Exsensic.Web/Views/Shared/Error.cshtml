@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<partial name="_PageHeader" model='@(new PageHeaderViewModel { Title = "Something went wrong.", Eyebrow = "Please try again", Subtitle = "We could not complete your request. Return home and try again shortly.", ActionText = "Return home", ActionUrl = Url.Action("Index", "Home") })' />
@if (Model.ShowRequestId)
{
    <p class="text-muted-ui">If you contact the team, include this support reference: <code>@Model.RequestId</code></p>
}
